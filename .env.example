# Copy this file to .env and fill in real values. Never commit the real .env file.

# Use a dedicated read-only-ish monitoring user (see setup notes in README/chat):
#   roles: [ { role: "clusterMonitor", db: "admin" },
#             { role: "readAnyDatabase", db: "admin" },
#             { role: "readWrite", db: "index_usage_monitoring" } ]
MONGODB_URI=mongodb+srv://<monitor_user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Database used to store the tracking data. Automatically excluded from being scanned.
MONITOR_DB_NAME=index_usage_monitoring

# Minimum number of hourly polls an index must have before it's eligible to be
# called "confirmed unused" in the report (guards against short outages/gaps).
MIN_POLLS_FOR_CONFIDENCE=100

# Port for the web dashboard (npm run ui). Defaults to 4000.
UI_PORT=4000
